root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{json,jsonc,yml,yaml,js,jsx,ts,tsx,css,scss,html}]
indent_size = 2

[*.{csproj,props,targets,xml}]
indent_size = 2

[*.cs]
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_prefer_primary_constructors = false:suggestion
csharp_new_line_before_open_brace = all
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_space_after_cast = false

[src/MachiVerseWorks.Simulation/SimulationWorld.Gas.cs]
dotnet_diagnostic.CA1512.severity = none
# IGasSupplySolver is an intentional substitution boundary; keep the field interface-typed.
dotnet_diagnostic.CA1859.severity = none
